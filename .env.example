# =====================================================================
# CAPSTONE MAGSENSE — Environment Variable Reference
# =====================================================================
# Copy this file and fill in real values for each environment.
# NEVER commit real secrets to Git.
# =====================================================================

# ---------------------------------------------------------------------
# EDGE ENVIRONMENT (Mac / Raspberry Pi)
# docker-compose.yml (edge)
# ---------------------------------------------------------------------

# MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=maggot/sensor/data
PUBLISH_INTERVAL_SEC=5

# Edge SQLite
SQLITE_DB_PATH=edge_local.db

# Cloud Sync — arahkan ke Central Backend
SYNC_URL=https://api-capstone.sangkolo.my.id/api/edge-sync
SYNC_INTERVAL_SEC=30

# CV Mock / Real
MOCK_CV=true
CV_INTERVAL_SEC=10

# Prediction
PREDICT_INTERVAL_SEC=20

# Edge Local API
LOCAL_API_PORT=8080

# ---------------------------------------------------------------------
# CENTRAL ENVIRONMENT (CT 801 Proxmox — /capstone/.env)
# docker-compose.central.yml
# ---------------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
POSTGRES_DB=smart_farming_db

# Backend — DB Connection
DB_USER=postgres
DB_PASS=YOUR_POSTGRES_PASSWORD_HERE
DB_HOST=postgres
DB_PORT=5432
DB_NAME=smart_farming_db

# Backend — Auth
JWT_SECRET=YOUR_JWT_SECRET_HERE
PORT=5000

# CV inference (set these on the Python inference service)
# Calibrated for best.pt v28 (run maggot_yolov8n_v28, TRAIN_IMGSZ=960; from
# 12D-KOREKSI in capstone6_v28.ipynb: Adult 0.55, Baby 0.20, Prepupa 0.40,
# Pupa 0.20 — P/R computed at each threshold on the valid set).
# Live values below are recall-first for small maggots on C270 frames: if the
# dashboard shows too many false positives, raise Adult first (0.40 -> 0.50).
YOLO_CONF=0.25
YOLO_IOU=0.6
YOLO_AUGMENT=false
# Class ids: 0 Adult, 1 Baby, 2 Prepupa, 3 Pupa
YOLO_CLASS_CONF={"0":0.40,"1":0.25,"2":0.30,"3":0.25}
YOLO_IMGSZ=960
# imgsz for the live-camera (WebRTC) path; defaults to 960 to match TRAIN_IMGSZ
YOLO_IMGSZ_LIVE=960
YOLO_MAX_DET=3000
# Tiling for high-res uploads (>= ~1920px) uses the settings below.
TILED_MIN_LONG_SIDE=1920
TILE_SIZE=960
TILE_OVERLAP=0.25
TILE_BORDER_PX=6
TILE_NMS_IOU=0.5

# --- Live camera (WebRTC) -------------------------------------------------
# Capture 720p (C270 native). 640x480 makes maggots a few pixels wide and was
# the main cause of missed live detections.
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
CAMERA_FOURCC=MJPG
# Tiling frame live: 2 -> 2x2 (recommended). Set 1 to disable tiling,
# 3 only if the CPU is fast (9 tiles).
YOLO_LIVE_TILING=1
YOLO_LIVE_TILES=2
YOLO_LIVE_TILE_OVERLAP=0.15
# Minimum seconds between detections (video keeps 30 fps; boxes refresh at
# ~1/interval). Lower = fresher boxes but higher CPU usage.
YOLO_LIVE_DETECT_INTERVAL=0.7
# Raw confidence before per-class filtering (leave empty for auto =
# lowest YOLO_CLASS_CONF - 0.05).
# YOLO_LIVE_RAW_CONF=0.20

# Initial admin bootstrap (optional; script can also accept email as argument)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_TENANT_ID=
BOOTSTRAP_ADMIN_PASSWORD=

# Dedicated test accounts (never use production accounts)
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_OPERATOR_EMAIL=
TEST_OPERATOR_PASSWORD=
ALLOW_REMOTE_TEST=false

# ---------------------------------------------------------------------
# FRONTEND BUILD ENVIRONMENT
# Diteruskan sebagai Docker build ARG di docker-compose.central.yml
# Tidak diperlukan file .env lokal — dikonfigurasi via docker-compose
# ---------------------------------------------------------------------

VITE_API_URL=https://api-capstone.sangkolo.my.id/api
VITE_WS_URL=https://api-capstone.sangkolo.my.id
