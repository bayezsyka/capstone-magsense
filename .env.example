# =====================================================================
# CAPSTONE MAGSENSE — Environment Variable Reference
# =====================================================================
# Copy this file and fill in real values for each environment.
# NEVER commit real secrets to Git.
# =====================================================================

# ---------------------------------------------------------------------
# EDGE ENVIRONMENT (Mac / Raspberry Pi)
# docker-compose.yml (edge)
# ---------------------------------------------------------------------

# MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=maggot/sensor/data
PUBLISH_INTERVAL_SEC=5

# Edge SQLite
SQLITE_DB_PATH=edge_local.db

# Cloud Sync — arahkan ke Central Backend
SYNC_URL=https://api-capstone.sangkolo.my.id/api/edge-sync
SYNC_INTERVAL_SEC=30

# CV Mock / Real
MOCK_CV=true
CV_INTERVAL_SEC=10

# Prediction
PREDICT_INTERVAL_SEC=20

# Edge Local API
LOCAL_API_PORT=8080

# ---------------------------------------------------------------------
# CENTRAL ENVIRONMENT (CT 801 Proxmox — /capstone/.env)
# docker-compose.central.yml
# ---------------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
POSTGRES_DB=smart_farming_db

# Backend — DB Connection
DB_USER=postgres
DB_PASS=YOUR_POSTGRES_PASSWORD_HERE
DB_HOST=postgres
DB_PORT=5432
DB_NAME=smart_farming_db

# Backend — Auth
JWT_SECRET=YOUR_JWT_SECRET_HERE
PORT=5000

# CV inference (set these on the Python inference service)
# Calibrated for best.pt maggot_yolov8n_v22 (TRAIN_IMGSZ=960; per-class F1
# optimum on the validation set: Adult 0.90, Baby 0.50, Prepupa 0.78, Pupa 0.47)
YOLO_CONF=0.25
YOLO_IOU=0.6
YOLO_AUGMENT=false
# Class ids: 0 Adult, 1 Baby, 2 Prepupa, 3 Pupa
YOLO_CLASS_CONF={"0":0.65,"1":0.45,"2":0.70,"3":0.45}
YOLO_IMGSZ=960
# imgsz for the live-camera (WebRTC) path; defaults to 960 to match TRAIN_IMGSZ
YOLO_IMGSZ_LIVE=960
YOLO_MAX_DET=3000
# Tiling only benefits high-res uploads (>= ~1920px); webcam 720p frames use
# the faster single-shot path (see inference.py benchmark notes)
TILED_MIN_LONG_SIDE=1920
TILE_SIZE=960
TILE_OVERLAP=0.25
TILE_BORDER_PX=6
TILE_NMS_IOU=0.5

# Initial admin bootstrap (optional; script can also accept email as argument)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_TENANT_ID=
BOOTSTRAP_ADMIN_PASSWORD=

# Dedicated test accounts (never use production accounts)
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_OPERATOR_EMAIL=
TEST_OPERATOR_PASSWORD=
ALLOW_REMOTE_TEST=false

# ---------------------------------------------------------------------
# FRONTEND BUILD ENVIRONMENT
# Diteruskan sebagai Docker build ARG di docker-compose.central.yml
# Tidak diperlukan file .env lokal — dikonfigurasi via docker-compose
# ---------------------------------------------------------------------

VITE_API_URL=https://api-capstone.sangkolo.my.id/api
VITE_WS_URL=https://api-capstone.sangkolo.my.id
