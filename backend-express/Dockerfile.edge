FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --production

# Copy all source code
COPY . .

# Set environment variables for Edge (SQLite mode)
ENV NODE_ENV=production
ENV DATA_SOURCE=sqlite
ENV SQLITE_DB_PATH=/app/data/edge_local.db

# Expose port
EXPOSE 5000

# Start server
CMD ["node", "server.js"]
